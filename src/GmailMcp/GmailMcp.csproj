<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-gmail</ToolCommandName>

    <!-- Package Metadata -->
    <PackageId>GmailMcp</PackageId>
    <PackageType>McpServer</PackageType>
    <Authors>Gmail MCP Contributors</Authors>
    <Description>Dual-mode Gmail integration tool supporting both direct CLI operations and MCP server mode for AI assistants. Search messages, read emails, and download attachments via command line or Model Context Protocol.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/brendankowitz/dotnet-gmail-mcp</RepositoryUrl>
    <PackageProjectUrl>https://github.com/brendankowitz/dotnet-gmail-mcp</PackageProjectUrl>
    <PackageTags>gmail;mcp;model-context-protocol;cli;ai;oauth2;dotnet-tool;claude</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="0.8.0-preview.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Google.Apis.Gmail.v1" Version="1.70.0.3673" />
    <PackageReference Include="Google.Apis.Auth" Version="1.70.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Polly" Version="8.5.0" />
    <PackageReference Include="AngleSharp" Version="1.5.0" />
    <PackageReference Include="GitVersion.MsBuild" Version="6.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\.mcp\server.json" Pack="true" PackagePath="/.mcp/" />
  </ItemGroup>

  <!-- Update server.json version before packing -->
  <Target Name="UpdateServerJsonVersion" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <ServerJsonPath>$(MSBuildProjectDirectory)\..\..\.mcp\server.json</ServerJsonPath>
      <ServerJsonContent>$([System.IO.File]::ReadAllText($(ServerJsonPath)))</ServerJsonContent>
      <!-- Replace version placeholders with actual version -->
      <ServerJsonContent>$(ServerJsonContent.Replace('"version": "0.0.0"', '"version": "$(PackageVersion)"'))</ServerJsonContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(ServerJsonPath)" Lines="$(ServerJsonContent)" Overwrite="true" />
  </Target>

</Project>
