{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-10-17/server.schema.json",
  "description": "Dual-mode Gmail integration tool supporting both direct CLI operations and MCP server mode for AI assistants. Search messages, read emails, and download attachments.",
  "name": "io.github.brendankowitz/dotnet-gmail-mcp",
  "version": "0.0.0",
  "packages": [
    {
      "registryType": "nuget",
      "registryBaseUrl": "https://api.nuget.org",
      "identifier": "GmailMcp",
      "version": "0.0.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        "mcp"
      ],
      "environmentVariables": []
    }
  ],
  "repository": {
    "url": "https://github.com/brendankowitz/dotnet-gmail-mcp",
    "source": "github"
  }
}
